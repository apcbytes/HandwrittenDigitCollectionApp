# Copy this file to secrets.toml and fill in your own values.
# NEVER commit secrets.toml to git.
#
# Get client_id / client_secret from Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# APIs & Services > Credentials > Create Credentials > OAuth client ID
#   Application type: Web application
#   Authorized redirect URI: http://localhost:8501/oauth2callback

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"

[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Separate password gate for the admin review page (pages/1_Admin.py).
# Change this before sharing the app with a class.
[admin]
username = "admin"
password = "admin123"

# ---------------------------------------------------------------------------
# Storage backend.
#   backend = "disk"   -> PNGs under data/ + data/labels.xlsx (LOCAL DEV ONLY;
#                          Streamlit Community Cloud wipes the filesystem).
#   backend = "cloud"  -> submissions log in a Google Sheet, PNGs in a Google
#                          Drive folder, via the service account below.
# Can also be forced with the env var HDCA_STORAGE_BACKEND=disk|cloud.
# ---------------------------------------------------------------------------
[storage]
backend = "disk"
# Only needed when backend = "cloud" — see DEPLOY.md:
# gsheet_id = "THE_GOOGLE_SHEET_FILE_ID"
# gdrive_folder_id = "THE_DRIVE_FOLDER_ID"

# Google service-account key (only needed when backend = "cloud").
# Paste the whole downloaded JSON key, field by field. Keep the \n escapes
# inside private_key exactly as they appear in the JSON.
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "hdca-storage@your-project-id.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
